<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/pv-pipeline.owl"
         xmlns="http://example.org/pv-pipeline.owl#">

<owl:Ontology rdf:about="http://example.org/pv-pipeline.owl"/>

<owl:ObjectProperty rdf:about="#hasStage">
  <rdfs:domain rdf:resource="#Pipeline"/>
  <rdfs:range rdf:resource="#Stage"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#precedes">
  <rdfs:domain rdf:resource="#Stage"/>
  <rdfs:range rdf:resource="#Stage"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasCandidateModel">
  <rdfs:domain rdf:resource="#Stage"/>
  <rdfs:range rdf:resource="#Model"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasParameter">
  <rdfs:domain rdf:resource="#Model"/>
  <rdfs:range rdf:resource="#Parameter"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#stageOrder">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Stage"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#pvlibFunction">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Model"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Pipeline">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Stage">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Model">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Parameter">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#PVSimulationPipeline">
  <rdf:type rdf:resource="#Pipeline"/>
  <hasStage rdf:resource="#IrradianceDecomposition"/>
  <hasStage rdf:resource="#POATransposition"/>
  <hasStage rdf:resource="#CellTemperature"/>
  <hasStage rdf:resource="#DCPower"/>
  <hasStage rdf:resource="#ACConversion"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#IrradianceDecomposition">
  <rdf:type rdf:resource="#Stage"/>
  <hasCandidateModel rdf:resource="#Erbs"/>
  <hasCandidateModel rdf:resource="#DISC"/>
  <hasCandidateModel rdf:resource="#DIRINT"/>
  <precedes rdf:resource="#POATransposition"/>
  <stageOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stageOrder>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Erbs">
  <rdf:type rdf:resource="#Model"/>
  <pvlibFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pvlib.irradiance.erbs</pvlibFunction>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#DISC">
  <rdf:type rdf:resource="#Model"/>
  <pvlibFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pvlib.irradiance.disc</pvlibFunction>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#DIRINT">
  <rdf:type rdf:resource="#Model"/>
  <pvlibFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pvlib.irradiance.dirint</pvlibFunction>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#POATransposition">
  <rdf:type rdf:resource="#Stage"/>
  <hasCandidateModel rdf:resource="#Isotropic"/>
  <hasCandidateModel rdf:resource="#HayDavies"/>
  <hasCandidateModel rdf:resource="#Perez"/>
  <precedes rdf:resource="#CellTemperature"/>
  <stageOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stageOrder>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Isotropic">
  <rdf:type rdf:resource="#Model"/>
  <pvlibFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pvlib.irradiance.isotropic</pvlibFunction>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HayDavies">
  <rdf:type rdf:resource="#Model"/>
  <pvlibFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pvlib.irradiance.haydavies</pvlibFunction>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Perez">
  <rdf:type rdf:resource="#Model"/>
  <pvlibFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pvlib.irradiance.perez</pvlibFunction>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#CellTemperature">
  <rdf:type rdf:resource="#Stage"/>
  <hasCandidateModel rdf:resource="#SAPMCell"/>
  <hasCandidateModel rdf:resource="#Faiman"/>
  <precedes rdf:resource="#DCPower"/>
  <stageOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stageOrder>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#SAPMCell">
  <rdf:type rdf:resource="#Model"/>
  <pvlibFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pvlib.temperature.sapm_cell</pvlibFunction>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Faiman">
  <rdf:type rdf:resource="#Model"/>
  <pvlibFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pvlib.temperature.faiman</pvlibFunction>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#DCPower">
  <rdf:type rdf:resource="#Stage"/>
  <hasCandidateModel rdf:resource="#SingleDiode"/>
  <hasCandidateModel rdf:resource="#PVWattsDC"/>
  <precedes rdf:resource="#ACConversion"/>
  <stageOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stageOrder>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#SingleDiode">
  <rdf:type rdf:resource="#Model"/>
  <pvlibFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pvlib.pvsystem.singlediode</pvlibFunction>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#PVWattsDC">
  <rdf:type rdf:resource="#Model"/>
  <pvlibFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pvlib.pvsystem.pvwatts_dc</pvlibFunction>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ACConversion">
  <rdf:type rdf:resource="#Stage"/>
  <hasCandidateModel rdf:resource="#SandiaInverter"/>
  <hasCandidateModel rdf:resource="#PVWattsInverter"/>
  <stageOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stageOrder>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#SandiaInverter">
  <rdf:type rdf:resource="#Model"/>
  <pvlibFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pvlib.inverter.sandia</pvlibFunction>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#PVWattsInverter">
  <rdf:type rdf:resource="#Model"/>
  <pvlibFunction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pvlib.inverter.pvwatts</pvlibFunction>
</owl:NamedIndividual>


</rdf:RDF>
